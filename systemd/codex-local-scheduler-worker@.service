[Unit]
Description=Run queued local workflow job %i

[Service]
Type=oneshot
Environment=CODEX_LOCAL_SCHEDULER_DATA=%h/.local/share/codex-local-scheduler
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/codex-local-scheduler/environment
UMask=0077
ExecStart=/usr/bin/env codex-local-scheduler run-queued %i
